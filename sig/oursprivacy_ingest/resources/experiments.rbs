module OursprivacyIngest
  module Resources
    class Experiments
      def assignment: (
        String experiment_key,
        token: String,
        visitor_id: String,
        ?context: OursprivacyIngest::ExperimentAssignmentParams::Context?,
        ?track_impression: bool?,
        ?request_options: OursprivacyIngest::request_opts
      ) -> OursprivacyIngest::Models::experiment_assignment_response

      def personalization: (
        token: String,
        visitor_id: String,
        ?request_options: OursprivacyIngest::request_opts
      ) -> OursprivacyIngest::Models::ExperimentPersonalizationResponse

      def initialize: (client: OursprivacyIngest::Client) -> void
    end
  end
end
